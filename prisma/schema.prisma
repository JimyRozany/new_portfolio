// ---------------------------------------------------------------------------
// Portfolio database schema --- MySQL 8
//
// Design notes (why the schema looks the way it does):
//
//  * **Bilingual by columns.** Every user-facing text field is duplicated as
//    `<field>_en` / `<field>_ar`. The specification asks for something simple
//    and easy to maintain for a single-owner portfolio, and a translations
//    table or a JSON blob would make every admin form and every query harder
//    for no practical gain at this size.
//
//  * **`MySql` char length is mandatory.** Prisma maps `String` to
//    `VARCHAR(191)`. Titles, slugs and platform names need a wider column, so
//    the lengths are declared explicitly to avoid surprise truncation.
//
//  * **Sort order is a column, not a position.** Manual ordering (`sort_order`)
//    beats "created_at" ordering because the owner decides what a visitor sees
//    first, and it survives edits that would otherwise reshuffle a section.
//
//  * **Enums are real enums.** MySQL supports them and Prisma 7 exposes them in
//    the client, so `status` is validated at the database level rather than
//    being a free-text string that drifts.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // NOTE: Prisma 7 removed `url` from the datasource block. The connection
  // string lives in `prisma.config.ts` and is passed to the client through a
  // driver adapter (see `src/lib/prisma.ts`).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  SPAM
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id Int @id @default(autoincrement())

  name String @db.VarChar(120)

  /// Always stored lower-cased and trimmed; the unique index then provides
  /// case-insensitive uniqueness without needing a functional index.
  email String @unique @db.VarChar(191)

  /// bcrypt hash --- never the plain password. The field is named to make that
  /// impossible to forget at a call site.
  passwordHash String @map("password_hash") @db.VarChar(191)

  role UserRole @default(ADMIN)

  avatar String? @db.VarChar(255)

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id Int @id @default(autoincrement())

  titleEn String @map("title_en") @db.VarChar(191)
  titleAr String @map("title_ar") @db.VarChar(191)

  /// URL segment, unique across the whole table and generated by the admin
  /// form from the English title. Kept separate from the title so renaming a
  /// project never breaks an existing link (and a slug can be customised).
  slug String @unique @db.VarChar(191)

  descriptionEn String @map("description_en") @db.VarChar(500)
  descriptionAr String @map("description_ar") @db.VarChar(500)

  longDescriptionEn String? @map("long_description_en") @db.Text
  longDescriptionAr String? @map("long_description_ar") @db.Text

  /// Path inside `public/uploads`; the `media` table owns the file record.
  thumbnail String? @db.VarChar(255)

  category String? @db.VarChar(120)

  /// Stack used to build the project, as a JSON array of strings. Stored as
  /// JSON rather than a join table because the list is only ever read whole,
  /// never aggregated on, and the project needs to be searchable by it.
  technologies Json?

  liveUrl String? @map("live_url") @db.VarChar(255)
  githubUrl String? @map("github_url") @db.VarChar(255)

  /// Highlighted projects are pinned to the top of the home page grid.
  featured Boolean @default(false)

  status ProjectStatus @default(DRAFT)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images ProjectImage[]

  @@index([status, sortOrder])
  @@index([featured, sortOrder])
  @@index([category])
  @@map("projects")
}

model ProjectImage {
  id Int @id @default(autoincrement())

  projectId Int @map("project_id")

  image String @db.VarChar(255)

  altEn String? @map("alt_en") @db.VarChar(191)
  altAr String? @map("alt_ar") @db.VarChar(191)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

// ---------------------------------------------------------------------------
// Skills
// ---------------------------------------------------------------------------

model SkillCategory {
  id Int @id @default(autoincrement())

  nameEn String @map("name_en") @db.VarChar(120)
  nameAr String @map("name_ar") @db.VarChar(120)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills Skill[]

  @@index([sortOrder])
  @@map("skill_categories")
}

model Skill {
  id Int @id @default(autoincrement())

  name String @db.VarChar(120)

  /// Icon name resolved through the shared icon map in the admin UI.
  icon String? @db.VarChar(120)

  categoryId Int? @map("category_id")

  /// 0-100, rendered as a progress bar. Nullable because some skills are
  /// listed without a self-assessed level.
  level Int?

  featured Boolean @default(false)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId, sortOrder])
  @@index([featured, sortOrder])
  @@map("skills")
}

// ---------------------------------------------------------------------------
// Experience
// ---------------------------------------------------------------------------

model Experience {
  id Int @id @default(autoincrement())

  company String @db.VarChar(191)

  positionEn String @map("position_en") @db.VarChar(191)
  positionAr String @map("position_ar") @db.VarChar(191)

  descriptionEn String? @map("description_en") @db.Text
  descriptionAr String? @map("description_ar") @db.Text

  startDate DateTime @map("start_date") @db.Date

  /// Null means "still working here"; the UI renders it as "Present".
  endDate DateTime? @map("end_date") @db.Date

  current Boolean @default(false)

  location String? @db.VarChar(120)

  /// Stack used in this role, as a JSON array of strings. Same rationale as
  /// `Project.technologies`: read whole, never aggregated on.
  technologies Json?

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("experiences")
}

// ---------------------------------------------------------------------------
// Education
// ---------------------------------------------------------------------------

model Education {
  id Int @id @default(autoincrement())

  institution String @db.VarChar(191)

  degreeEn String @map("degree_en") @db.VarChar(191)
  degreeAr String @map("degree_ar") @db.VarChar(191)

  fieldEn String? @map("field_en") @db.VarChar(191)
  fieldAr String? @map("field_ar") @db.VarChar(191)

  descriptionEn String? @map("description_en") @db.Text
  descriptionAr String? @map("description_ar") @db.Text

  startDate DateTime @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date

  current Boolean @default(false)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("educations")
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model Service {
  id Int @id @default(autoincrement())

  titleEn String @map("title_en") @db.VarChar(191)
  titleAr String @map("title_ar") @db.VarChar(191)

  descriptionEn String @map("description_en") @db.VarChar(500)
  descriptionAr String @map("description_ar") @db.VarChar(500)

  icon String? @db.VarChar(120)

  /// Bullet points. Stored as a JSON array of strings because the list is
  /// short, always read in full, and never queried or joined against --- a
  /// normalised child table would add joins for no benefit.
  featuresEn Json? @map("features_en")
  featuresAr Json? @map("features_ar")

  active Boolean @default(true)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Testimonials
// ---------------------------------------------------------------------------

model Testimonial {
  id Int @id @default(autoincrement())

  name String @db.VarChar(120)

  positionEn String? @map("position_en") @db.VarChar(120)
  positionAr String? @map("position_ar") @db.VarChar(120)

  company String? @db.VarChar(120)

  avatar String? @db.VarChar(255)

  contentEn String @map("content_en") @db.Text
  contentAr String @map("content_ar") @db.Text

  /// 1-5, validated in the admin form.
  rating Int @default(5)

  featured Boolean @default(false)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([featured, sortOrder])
  @@map("testimonials")
}

// ---------------------------------------------------------------------------
// Social links
// ---------------------------------------------------------------------------

model SocialLink {
  id Int @id @default(autoincrement())

  /// Matches the keys of the shared social icon map (`github`, `linkedin`, ...).
  platform String @db.VarChar(60)

  url String @db.VarChar(255)

  icon String? @db.VarChar(60)

  active Boolean @default(true)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platform])
  @@index([active, sortOrder])
  @@map("social_links")
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------

model ContactMessage {
  id Int @id @default(autoincrement())

  name String @db.VarChar(120)
  email String @db.VarChar(191)
  subject String @db.VarChar(191)
  message String @db.Text

  status MessageStatus @default(NEW)

  /// Free-form notes the owner adds while handling the message.
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model Media {
  id Int @id @default(autoincrement())

  /// Public path (`/uploads/<file>`), not a filesystem path --- the upload root
  /// is configurable and must never leak into stored data.
  path String @db.VarChar(255)

  filename String @db.VarChar(191)

  mimeType String @map("mime_type") @db.VarChar(120)

  size Int

  width Int?
  height Int?

  altEn String? @map("alt_en") @db.VarChar(191)
  altAr String? @map("alt_ar") @db.VarChar(191)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Key/value settings
// ---------------------------------------------------------------------------

model SiteSetting {
  id Int @id @default(autoincrement())

  key String @unique @db.VarChar(120)

  /// Values are heterogeneous by design (booleans, numbers, nested JSON), so
  /// the column is text and the admin layer casts on read.
  value String @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tabs": "^1.1.21",
        "@radix-ui/react-tooltip": "^1.2.16",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^18.0.4",
        "lucide-react": "^1.48.0",
        "mariadb": "^3.5.4",
        "motion": "^13.4.6",
        "next": "^16.3.7",
        "next-intl": "^4.14.8",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.89.0",

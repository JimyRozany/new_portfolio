{
    "name": "mohamed-gamal-portfolio",
    "version": "0.1.0",
    "description": "Premium bilingual (EN/AR) developer portfolio website with a built-in CMS dashboard.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "validate": "npm run lint && npm run typecheck && npm run build",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset --force",
        "db:reset-password": "tsx prisma/reset-password.ts"
    },
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20.9.0"
    },
    "dependencies": {

        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.7",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prisma": "^7.10.0",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"

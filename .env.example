# ---------------------------------------------------------------------------
# Database (MySQL 8) — https://dev.mysql.com/doc/
#
# The runtime client connects through `@prisma/adapter-mariadb` (the MariaDB
# driver speaks the MySQL wire protocol), so the URL is a standard MySQL DSN.
# ---------------------------------------------------------------------------
# Local development:
DATABASE_URL="mysql://dev:password@127.0.0.1:3306/portfolio_db"
# Production (managed provider, e.g. PlanetScale / AWS RDS / DigitalOcean):
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB?ssl=true"

# ---------------------------------------------------------------------------
# Auth.js — generate with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Optional: reuse NextAuth v4 style variable name if you prefer.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Credentials provider (admin dashboard login).
ADMIN_EMAIL="admin@rozny.dev"
ADMIN_PASSWORD="ChangeMe!2026"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Media uploads (local disk by default; swap for S3/R2 in production)
# ---------------------------------------------------------------------------
MEDIA_STORAGE_DRIVER="local"
MAX_UPLOAD_SIZE_MB="5"

# ---------------------------------------------------------------------------
# Public contact form spam protection (https://hcaptcha.com / turnstile.cloudflare.com)
# Leave empty to keep the honeypot-only protection.
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
